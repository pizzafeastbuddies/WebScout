{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config eval/vitest.config.ts eval/run.eval.ts",
    "typecheck:eval": "tsc -p eval/tsconfig.json",
    "build:server": "vite build --config app/vite.server.config.ts",
    "test:app": "python -m unittest discover -s app -p test_*.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "parse5": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.12"
  }
}